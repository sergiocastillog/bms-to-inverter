[Unit]
Description=Fidus FB-L-16 to Axpert Pylon RS485 gateway
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/sergio/fidus-gateway/reference/bms-to-inverter
# The user systemd manager was started before sergio joined dialout; sg supplies
# the serial-device group without requiring a user-session restart.
ExecStart=/usr/bin/sg dialout -c '/usr/bin/java -DconfigFile=/home/sergio/fidus-gateway/reference/bms-to-inverter/bms-to-inverter-main/src/main/resources/config-fidus-axpert.properties -jar /home/sergio/fidus-gateway/reference/bms-to-inverter/bms-to-inverter-main/target/bms-to-inverter-main-0.0.1-SNAPSHOT.jar'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
